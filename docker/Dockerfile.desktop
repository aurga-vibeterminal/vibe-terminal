# vibe-terminal Linux desktop build environment (Ubuntu 22.04 jammy, glibc 2.35)
#
# Builds the desktop variant (vterm-server, vterm, vtermc — Skia from vendored
# sources) for x64 (native) and cross: arm64 / x86(-m32) / arm32(armhf) /
# riscv64, plus the riscv64 headless variant.
# The bionic image (docker/Dockerfile) cannot do this: Skia m145 needs C++20
# library headers (<compare> …), and bionic's cross toolchains are gcc-7.
# Jammy has gcc-12 with full C++20 and complete i386/armhf/arm64 multiarch,
# and — unlike Debian 12 — riscv64 is an official architecture (ubuntu-ports).
# Desktop packages therefore carry a 22.04+ baseline; the bionic-built x64
# desktop and all non-riscv64 headless packages keep the glibc 2.27 baseline.
#
# Also hosts the riscv64 vterm-screen-server build (docker/build_desktop screen):
# PipeWire/D-Bus for riscv64 are extracted into /opt/sysroots (see below),
# and the binary carries the same 22.04+ baseline.
#
# Build via ./build_desktop [x86|arm64|arm32|riscv64|all|screen] from this
# directory.

FROM ubuntu:22.04

ARG PROXY=""
ARG UBUNTU_MIRROR="http://archive.ubuntu.com/ubuntu"
ARG UBUNTU_PORTS_MIRROR="http://ports.ubuntu.com/ubuntu-ports"

ENV DEBIAN_FRONTEND=noninteractive

# Ubuntu 22.04 (jammy) apt sources. Defaults are the canonical Ubuntu
# archives; pass a nearby mirror through docker/build (or --build-arg) to
# speed up downloads, e.g. UBUNTU_MIRROR=http://mirrors.tuna.tsinghua.edu.cn/ubuntu
# and UBUNTU_PORTS_MIRROR=http://mirrors.tuna.tsinghua.edu.cn/ubuntu-ports.
# amd64/i386 come from the main archive, arm64/armhf/riscv64 from ubuntu-ports.
# riscv64 is an official jammy architecture — no third-party repo needed.
RUN dpkg --add-architecture arm64 && \
    dpkg --add-architecture armhf && \
    dpkg --add-architecture i386 && \
    dpkg --add-architecture riscv64 && \
    echo "deb [arch=amd64,i386] ${UBUNTU_MIRROR}/ jammy main restricted universe multiverse" > /etc/apt/sources.list && \
    echo "deb [arch=amd64,i386] ${UBUNTU_MIRROR}/ jammy-updates main restricted universe multiverse" >> /etc/apt/sources.list && \
    echo "deb [arch=amd64,i386] ${UBUNTU_MIRROR}/ jammy-security main restricted universe multiverse" >> /etc/apt/sources.list && \
    echo "deb [arch=arm64,armhf,riscv64] ${UBUNTU_PORTS_MIRROR}/ jammy main restricted universe multiverse" >> /etc/apt/sources.list && \
    echo "deb [arch=arm64,armhf,riscv64] ${UBUNTU_PORTS_MIRROR}/ jammy-updates main restricted universe multiverse" >> /etc/apt/sources.list && \
    echo "deb [arch=arm64,armhf,riscv64] ${UBUNTU_PORTS_MIRROR}/ jammy-security main restricted universe multiverse" >> /etc/apt/sources.list && \
    apt-get update

# Base build tools + packaging tools (dpkg-deb is in the base system).
RUN apt-get install -y --no-install-recommends \
        build-essential \
        pkg-config \
        git \
        curl \
        ca-certificates \
        python3 \
        file \
        unzip \
        xz-utils \
        rpm \
    && rm -rf /var/lib/apt/lists/*

# Cross toolchains: arm64 / armhf / x86(-m32 multilib) / riscv64. gcc-12
# provides the C++20 libstdc++ headers Skia needs, for every target.
RUN apt-get update && apt-get install -y --no-install-recommends \
        gcc-12-aarch64-linux-gnu \
        g++-12-aarch64-linux-gnu \
        gcc-12-arm-linux-gnueabihf \
        g++-12-arm-linux-gnueabihf \
        gcc-12-multilib \
        g++-12-multilib \
        gcc-12-riscv64-linux-gnu \
        g++-12-riscv64-linux-gnu \
    && rm -rf /var/lib/apt/lists/*

# libudev for every target (serialport).
RUN apt-get update && apt-get install -y --no-install-recommends \
        libudev-dev \
        libudev-dev:i386 \
        libudev-dev:arm64 \
        libudev-dev:armhf \
        libudev-dev:riscv64 \
    && rm -rf /var/lib/apt/lists/*

# Desktop link libraries for every target: skia x11 backend (X11/Xext/Xrender/
# Xrandr/GL), fontconfig, and ALSA (vterm client's cpal). freetype is
# embedded by skia (embed-freetype feature), so no libfreetype-dev needed.
RUN apt-get update && apt-get install -y --no-install-recommends \
        libx11-dev \
        libx11-dev:i386 \
        libx11-dev:arm64 \
        libx11-dev:armhf \
        libx11-dev:riscv64 \
    && rm -rf /var/lib/apt/lists/*
RUN apt-get update && apt-get install -y --no-install-recommends \
        libxext-dev \
        libxext-dev:i386 \
        libxext-dev:arm64 \
        libxext-dev:armhf \
        libxext-dev:riscv64 \
    && rm -rf /var/lib/apt/lists/*
RUN apt-get update && apt-get install -y --no-install-recommends \
        libxrender-dev \
        libxrender-dev:i386 \
        libxrender-dev:arm64 \
        libxrender-dev:armhf \
        libxrender-dev:riscv64 \
    && rm -rf /var/lib/apt/lists/*
RUN apt-get update && apt-get install -y --no-install-recommends \
        libxrandr-dev \
        libxrandr-dev:i386 \
        libxrandr-dev:arm64 \
        libxrandr-dev:armhf \
        libxrandr-dev:riscv64 \
    && rm -rf /var/lib/apt/lists/*
RUN apt-get update && apt-get install -y --no-install-recommends \
        libgl1-mesa-dev \
        libgl1-mesa-dev:i386 \
        libgl1-mesa-dev:arm64 \
        libgl1-mesa-dev:armhf \
    && rm -rf /var/lib/apt/lists/*
# riscv64 GL: extract glvnd's dev files WITHOUT apt's dependency resolution.
# Any apt-installed GL package pulls the mesa chain (libglx-mesa0 ->
# libllvm15 -> libtinfo6), and ubuntu-ports lags the main archive, so
# Multi-Arch:same version equality can never be satisfied there. Linking
# only needs libGL.so (glvnd stub) + headers + gl.pc; users still get mesa
# at runtime.
RUN apt-get update && mkdir -p /tmp/rvgl && cd /tmp/rvgl && \
    apt-get download libglvnd0:riscv64 libgl1:riscv64 libglx0:riscv64 \
        libgl-dev:riscv64 libglx-dev:riscv64 && \
    for d in *.deb; do dpkg-deb -x "$d" /; done && \
    rm -rf /tmp/rvgl && rm -rf /var/lib/apt/lists/*
RUN apt-get update && apt-get install -y --no-install-recommends \
        libfontconfig-dev \
        libfontconfig-dev:i386 \
        libfontconfig-dev:arm64 \
        libfontconfig-dev:armhf \
        libfontconfig-dev:riscv64 \
    && rm -rf /var/lib/apt/lists/*
RUN apt-get update && apt-get install -y --no-install-recommends \
        libasound2-dev \
        libasound2-dev:i386 \
        libasound2-dev:arm64 \
        libasound2-dev:armhf \
        libasound2-dev:riscv64 \
    && rm -rf /var/lib/apt/lists/*

# riscv64 sysroot for the vterm-screen-server "screen" build mode
# (docker/build_desktop screen): the glibc / D-Bus / X11 dev files are needed
# for the cross build, but apt-installing them is impossible here — libc6-dev
# is already installed for amd64 and ports lags the main archive, so
# Multi-Arch:same version equality can never be satisfied. Same workaround
# as the riscv64 GL extraction above: download (never install) the .debs and
# extract them under /opt/sysroots/riscv64-linux-gnu. build_desktop_inner.sh
# points pkg-config (PKG_CONFIG_SYSROOT_DIR) and bindgen (--sysroot via
# BINDGEN_EXTRA_CLANG_ARGS_riscv64gc_unknown_linux_gnu) at this sysroot.
#
# The PipeWire/D-Bus dev files below are jammy's 0.3.48 — a PLACEHOLDER. The
# final cross-compile layer (bottom of this file) replaces the sysroot's
# PipeWire/SPA headers + libpipewire-0.3 + .pc with a cross-built 0.3.65
# (jammy's 0.3.48 SPA VideoInfo ABI predates the .flags/u64-modifier layout
# vterm-screen-server's libspa-sys wrapper needs). They are kept here so this
# layer stays byte-identical and the expensive LLVM/ninja/Rust layers below
# remain cached when only the cross-compile changes.
RUN apt-get update && mkdir -p /tmp/rvscreen /opt/sysroots/riscv64-linux-gnu && cd /tmp/rvscreen && \
    apt-get download \
        libc6-dev:riscv64 linux-libc-dev:riscv64 \
        libpipewire-0.3-dev:riscv64 libpipewire-0.3-0:riscv64 \
        libspa-0.2-dev:riscv64 \
        libdbus-1-dev:riscv64 libdbus-1-3:riscv64 \
        libxdo-dev:riscv64 libxdo3:riscv64 \
        libxkbcommon-dev:riscv64 libxkbcommon0:riscv64 && \
    for d in *.deb; do dpkg-deb -x "$d" /opt/sysroots/riscv64-linux-gnu; done && \
    # Drop the .a files (so -ldbus-1 links the shared lib, not the static
    # archive that drags in undefined libsystemd sd_* symbols) and rewrite
    # Debian's absolute dev .so symlinks (libdbus-1.so -> /lib/riscv64.../..) to
    # be relative; stubs whose target was never extracted (glibc runtime,
    # supplied by the riscv64 cross gcc) are dropped. Same as Dockerfile.screen.
    find /opt/sysroots/riscv64-linux-gnu -name "*.a" -delete && \
    SR=/opt/sysroots/riscv64-linux-gnu; \
    find "$SR" -type l | while IFS= read -r link; do \
        tgt=$(readlink "$link"); \
        case "$tgt" in \
            /*) abs="$SR$tgt"; if [ -e "$abs" ]; then ln -srf "$abs" "$link"; else rm -f "$link"; fi ;; \
        esac; \
    done && \
    rm -rf /tmp/rvscreen && rm -rf /var/lib/apt/lists/*

# LLVM/clang 18 from apt.llvm.org (jammy's clang-14 is too old for Skia
# m145; libclang 18 also drives bindgen). trusted=yes avoids pulling gnupg
# just for one key; the repo itself is fetched through the proxy.
RUN echo "deb [trusted=yes] http://apt.llvm.org/jammy/ llvm-toolchain-jammy-18 main" \
        > /etc/apt/sources.list.d/llvm18.list && \
    http_proxy="$PROXY" https_proxy="$PROXY" apt-get update && \
    http_proxy="$PROXY" https_proxy="$PROXY" apt-get install -y --no-install-recommends \
        clang-18 \
        libclang-18-dev \
    && rm -rf /var/lib/apt/lists/* && \
    ln -s /usr/bin/clang-18 /usr/local/bin/clang && \
    ln -s /usr/bin/clang++-18 /usr/local/bin/clang++
ENV LIBCLANG_PATH=/usr/lib/llvm-18/lib

# gn (not in the Ubuntu archive) + recent ninja for the Skia build.
RUN http_proxy="$PROXY" https_proxy="$PROXY" \
        curl -fsSL -o /tmp/gn.zip \
            "https://chrome-infra-packages.appspot.com/dl/gn/gn/linux-amd64/+/latest" && \
    unzip -o /tmp/gn.zip -d /usr/local/bin && \
    rm /tmp/gn.zip && \
    http_proxy="$PROXY" https_proxy="$PROXY" \
        curl -fsSL -o /tmp/ninja.zip \
            https://github.com/ninja-build/ninja/releases/download/v1.12.1/ninja-linux.zip && \
    unzip -o /tmp/ninja.zip -d /usr/local/bin && \
    rm /tmp/ninja.zip && \
    chmod +x /usr/local/bin/gn /usr/local/bin/ninja

# Rust toolchain: must match /rust-toolchain.toml (channel + rustfmt), plus
# the cross-compile std libraries. Downloads come from the official static
# server; when direct access is slow (or routed through a proxy), pass a
# mirror, e.g.
#   RUSTUP_DIST_SERVER=https://mirrors.ustc.edu.cn/rust-static
#   RUSTUP_UPDATE_ROOT=https://mirrors.ustc.edu.cn/rust-static/rustup
ARG RUSTUP_DIST_SERVER="https://static.rust-lang.org"
ARG RUSTUP_UPDATE_ROOT="https://static.rust-lang.org/rustup"
ENV RUSTUP_HOME=/opt/rustup \
    CARGO_HOME=/opt/cargo \
    PATH=/opt/cargo/bin:$PATH \
    RUSTUP_DIST_SERVER=${RUSTUP_DIST_SERVER} \
    RUSTUP_UPDATE_ROOT=${RUSTUP_UPDATE_ROOT}

RUN http_proxy="$PROXY" https_proxy="$PROXY" \
        curl -sSf https://sh.rustup.rs | sh -s -- -y \
            --default-toolchain 1.96.0 \
            --profile minimal \
            --component rustfmt \
    && rustup target add --toolchain 1.96.0 \
        i686-unknown-linux-gnu \
        aarch64-unknown-linux-gnu \
        armv7-unknown-linux-gnueabihf \
        riscv64gc-unknown-linux-gnu

# The container runs as the host user (docker run -u uid:gid); give it write
# access so rustup can install missing components/toolchains if the pinned
# rust-toolchain.toml ever moves ahead of this image.
RUN chmod -R a+rwX /opt/rustup /opt/cargo

# Cross-compile PipeWire 0.3.65 for riscv64 into /opt/sysroots (jammy ships
# 0.3.48, whose SPA VideoInfo ABI predates the .flags/u64-modifier layout
# vterm-screen-server's libspa-sys wrapper requires). Self-contained: it pulls
# the riscv64 build deps into a throwaway tree, cross-builds ONLY the
# libpipewire-0.3 client lib (its daemon/plugin modules are not needed and
# drag in libsystemd->libgcrypt->libgpg-error), replaces the sysroot's
# PipeWire/SPA headers + libpipewire-0.3 + .pc with 0.3.65, and removes the
# throwaway tree. Kept as the final layer so the LLVM/ninja/Rust layers above
# stay cached when only this cross-compile changes. Needs ninja (gn/ninja
# layer); meson is installed by the script itself.
COPY cross-pipewire-riscv64.sh /usr/local/bin/cross-pipewire-riscv64.sh
RUN bash /usr/local/bin/cross-pipewire-riscv64.sh "$PROXY"
